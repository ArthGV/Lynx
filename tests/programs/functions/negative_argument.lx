// a space before '-' and none after makes it a negative argument
f: x
  >>> x
g: a, b
  >>> a + b
n: 5

// statement position
f -1
>> f -1
>> f -2.5
>> g -1, -2
>> g 10, -3

// expression and assignment position
y: f -1
>> y
>> (f -1) + 1
>> n - 1
>> n-1
>> 3 - 1

// still a normal call
>> f 1
>> f (0 - 7)
