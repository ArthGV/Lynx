{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "///",
      "///"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "'",
      "'"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:else|loop|if)\\b.*$",
    "decreaseIndentPattern": "^\\s*(?:else)\\b.*$"
  }
}
